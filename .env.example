# Получить токен у @BotFather в Telegram
BOT_TOKEN=123456789:AAHdqTcvCH1vGWJxfSeofSAs0K5PALDsaw

# Необязательно: доп. боты для одного процесса, через запятую (Phase 7,
# см. docs/BOT_IDENTITY_ARCHITECTURE.md). Каждый токен всё равно нужно
# привязать к арендатору: python -m app.register_bot --tenant-id <uuid>
# BOT_TOKENS=

# Необязательно: выделенный бот платформенной админки /platform (Phase 8, см.
# docs/PLATFORM_CONTROL_PLANE.md). Не задан — живой /platform недоступен,
# платформенные операции остаются доступны через сервисный слой и CLI.
# PLATFORM_BOT_TOKEN=

# Telegram ID администратора (узнать у @userinfobot). Несколько — через запятую.
ADMIN_ID=123456789

# Часовой пояс барбершопа
TIMEZONE=Europe/Chisinau

# Учётные данные PostgreSQL (использует docker-compose.yml для db и для сборки
# DATABASE_URL бота). ⚠️ Задайте свои значения перед продакшен-развёртыванием —
# без них compose тихо подставит дефолт barber/barber.
POSTGRES_USER=barber
POSTGRES_PASSWORD=barber
POSTGRES_DB=barbershop

# Язык по умолчанию: ru | ro | en
DEFAULT_LANGUAGE=ru

# Валюта услуг (3 буквы ISO 4217)
DEFAULT_CURRENCY=MDL

# --- Необязательные ---------------------------------------------------------

# Название, адрес и телефон барбершопа (отображаются в боте)
SHOP_NAME=Barbershop
SHOP_ADDRESS=Кишинёв
SHOP_PHONE=+373 60 000 000
# SHOP_MAPS_URL=https://maps.google.com/?q=...

# Логирование
# LOG_LEVEL=INFO
# SQL_ECHO=false

# Бизнес-правила
# SLOT_STEP_MINUTES=15
# BOOKING_HORIZON_DAYS=14
# MIN_LEAD_MINUTES=60
# CANCEL_MIN_LEAD_MINUTES=120
# MAX_ACTIVE_APPOINTMENTS=3

# Антифлуд
# THROTTLE_INTERVAL=0.4
# THROTTLE_BURST=10

# Redis для FSM-состояний (рекомендуется для продакшена)
# Без Redis состояния теряются при перезапуске бота (прерываются процессы записи)
# REDIS_URL=redis://localhost:6379/0

# Загрузить демо-данные при первом старте (4 услуги, 2 барбера, график Пн–Сб)
# SEED_ON_START=true

# Запросить номер телефона при первой записи
# REQUIRE_PHONE=false

# Через сколько недель после последнего визита напомнить записаться снова (0 = отключить)
# RETURN_REMINDER_WEEKS=3
